+extern "C" bool p12_argmax(const ggml_tensor*x,ggml_tensor*y,cudaStream_t stream){
+ const auto mode=setting("P12_ARGMAX");if(mode.empty())return false;
+ if(x->type!=GGML_TYPE_F32||y->type!=GGML_TYPE_I32||!ggml_is_contiguous(x)||x->ne[0]!=VOCAB||ggml_nrows(x)>256)throw std::runtime_error("unsupported H5 argmax shape");
+ if(mode=="vector")launch_argmax((const float*)x->data,x->ne[0],(int*)y->data,ggml_nrows(x),stream);
+ else if(mode=="split"){
+  auto it=arg_scratch.find(stream);if(it==arg_scratch.end()){
+   if(arg_scratch.size()>=arg_preallocated.size())throw std::runtime_error("argmax scratch not initialized");
+   it=arg_scratch.emplace(stream,arg_preallocated[arg_scratch.size()]).first;
+  }
+  launch_argmax_split((const float*)x->data,x->ne[0],(int*)y->data,ggml_nrows(x),it->second.keys,it->second.counts,stream);
+ }else throw std::runtime_error("unknown argmax mode");
+ return true;
+}
