+__global__ void p12_check_identity(const int*ids,int n,int first,int*safe){if(threadIdx.x==0){int ok=1;for(int i=0;i<n;i++)ok&=ids[i]==first+i;*safe=ok;}}
+
+__global__ void p12_gather_if_needed(const float*base,const int*ids,int64_t stride,float*out,int64_t width,int n,const int*safe,bool half_storage){
+ if(*safe)return;int64_t count=width*n;
+ for(int64_t i=(int64_t)blockIdx.x*blockDim.x+threadIdx.x;i<count;i+=(int64_t)gridDim.x*blockDim.x){int64_t j=(int64_t)ids[i/width]*stride+i%width;out[i]=half_storage?__half2float(((const half*)base)[j]):base[j];}
+}
+
+extern "C" void p12_register_gather(const ggml_tensor*node,const float*base,const int*ids,int64_t stride,float*tmp,int64_t width,int n,int first,cudaStream_t stream,bool half_storage){
+ if(!gather_safe)throw std::runtime_error("direct gather flags not initialized");
+ p12_check_identity<<<1,32,0,stream>>>(ids,n,first,gather_safe);
+ p12_gather_if_needed<<<1024,256,0,stream>>>(base,ids,stride,tmp,width,n,gather_safe,half_storage);
+ gathers[node]={base,ids,gather_safe,stride,half_storage};
+}
+
+extern "C" void p12_get_gather(const ggml_tensor*node,const float**base,const int**ids,const int**safe,int64_t*stride,bool*half_storage){
+ auto it=gathers.find(node);if(it==gathers.end()){*base=nullptr;*ids=nullptr;*safe=nullptr;*stride=0;*half_storage=false;return;}
+ *base=it->second.base;*ids=it->second.ids;*safe=it->second.safe;*stride=it->second.stride;*half_storage=it->second.half;
+}
