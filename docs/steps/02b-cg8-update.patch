+ for(int j=0;j<32/CG;j++) {
+  float4 s=st[j],kk=kr[j],qq=qr[j];
+  s.x=gv*s.x+kk.x*delta;s.y=gv*s.y+kk.y*delta;s.z=gv*s.z+kk.z*delta;s.w=gv*s.w+kk.w*delta;
+  val=fmaf(s.x,qq.x,val);val=fmaf(s.y,qq.y,val);val=fmaf(s.z,qq.z,val);val=fmaf(s.w,qq.w,val);
