+ uint3 hmagic,uint3 seqmagic,float scale,const int32_t*ids,int64_t row_stride,
+ const float*direct=nullptr,const int*direct_ids=nullptr,const int*safe=nullptr,int64_t direct_stride=0,bool input_half=false,bool output_half=false) {
+ ggml_cuda_pdl_sync();
+ input_half=input_half && safe && *safe;
+ if(safe&&*safe){input=direct;ids=direct_ids;row_stride=direct_stride;}
+ const int h=blockIdx.x,seq=blockIdx.y,lane=threadIdx.x%CG,col=blockIdx.z*(128/CG)+threadIdx.x/CG;
+ const int qh=fastmodulo(h,hmagic),qs=fastdiv(seq,seqmagic);
+ const float*kp=k+qs*sq3+qh*sq1;const float*qp=q+qs*sq3+qh*sq1;
+ const int64_t offset=(ids?(int64_t)ids[seq]*row_stride:(int64_t)seq*H*128*128)+(int64_t)h*128*128+col*128;
+ const float4*sp=(const float4*)(input+offset);
+ float4 st[32/CG],kr[32/CG],qr[32/CG];
+ float dot=0.f;
+ #pragma unroll
+ for(int j=0;j<32/CG;j++) {
+  int i=j*CG+lane;if(input_half){const half2*p=(const half2*)((const half*)input+offset);float2 a=__half22float2(p[2*i]),b=__half22float2(p[2*i+1]);st[j]=make_float4(a.x,a.y,b.x,b.y);}else st[j]=sp[i];kr[j]=((const float4*)kp)[i];qr[j]=((const float4*)qp)[i];
+  dot=fmaf(st[j].x,kr[j].x,dot);dot=fmaf(st[j].y,kr[j].y,dot);dot=fmaf(st[j].z,kr[j].z,dot);dot=fmaf(st[j].w,kr[j].w,dot);
+ }
+ #pragma unroll
+ for(int off=CG/2;off;off/=2)dot+=__shfl_xor_sync(0xffffffff,dot,off,CG);
